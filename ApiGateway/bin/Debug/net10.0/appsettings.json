{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "restaurant-route": {
        "ClusterId": "restaurant-cluster",
        "Match": {
          "Path": "/api/restaurants/{**catch-all}"
        }
      },
      "menu-route": {
        "ClusterId": "restaurant-cluster",
        "Match": {
          "Path": "/api/menuitems/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "delivery-route": {
        "ClusterId": "delivery-cluster",
        "Match": {
          "Path": "/api/deliveries/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "restaurant-cluster": {
        "Destinations": {
          "restaurant-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-destination": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "delivery-cluster": {
        "Destinations": {
          "delivery-destination": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  }
}
